{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "dist/**",
    "docs/superpowers/**",
    "node_modules/**",
    ".agents/**",
    ".superpowers/**",
    ".DS_Store"
  ]
}
